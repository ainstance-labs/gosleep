{
  "name": "@gosleep/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "gosleep-core: local Bun+Hono control plane for the gosleep web harness (127.0.0.1:7331)",
  "scripts": {
    "dev": "bun run --watch src/serve.ts",
    "start": "bun run src/serve.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:snapshot": "bash scripts/snapshot.sh",
    "db:restore": "bash scripts/restore-snapshot.sh"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.7.0",
    "pino": "^9.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.6.0"
  }
}
