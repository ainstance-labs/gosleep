# OS noise
.DS_Store

# Env / secrets — never committed
.env
.env.*

# Orchestration artifacts (project-scoped scratch, per orchestrating-delivery-agents)
.artifacts/
docs/reviews/

# Orchestrator heartbeat — runtime liveness signal + its atomic temp (GSL-51), never committed
docs/handoff/.orchestrator-heartbeat*

# Watchdog ledger — runtime record beside the heartbeat (GSL-55, format: tools/watchdog/LEDGER.md)
docs/handoff/.watchdog-*

# Node
node_modules/

# Lab UI build scratch — esbuild's compiled renderer, rebuilt from src/ on every chronicler pass.
# Derived from committed sources; committing it would be committing a second copy of them.
tools/lab/ui/.build/

# Python
__pycache__/
*.pyc

# Editor
.vscode/

# Eval runner — transient per-run config (copy from run-config.example.json, never commit)
evals/runner/run-config.json

# Eval RED baseline cache — local derived artifact, mixed N, not source of truth
evals/baselines/

# Research cache — clones of third-party repos for deep-research, not committed
.research-cache/

# Claude Code runtime (не коммитить)
.claude/scheduled_tasks.lock

# Laboratory scratch — temps, partials, hook traces, drop counters (PRD Phase 4 R4.3).
# Everything ELSE under docs/lab/ IS committed: it is the owner's phone-readable surface.
docs/lab/scratch/
# Hidden atomic-write temps: a chronicler killed mid-write (kill -9 = no cleanup)
# leaves one beside its target. lab-write sweeps them on the next pass; git never sees them.
docs/lab/.*.tmp
docs/lab/**/.*.tmp

# Browser tooling runtime — written by the agent's own tools, never by the project.
# gstack's browse skill drops its audit log and a capability probe here.
.gstack/
# The Playwright CLI dumps one page-<timestamp>.yml snapshot per look at a page:
# dozens per QA session, all reproducible by looking again. Untracked they only
# lengthened `git status` for the next agent — and rode along on any `git add -A`.
.playwright-cli/
