# The shim reads these from process.env — installed session-wide (launchd label / shell profile).
# See tools/hooks/ask-user-question-hook.sh header for the full contract.
GOSLEEP_CORE_URL=http://127.0.0.1:7331
GOSLEEP_INTERNAL_SECRET=<random-32-hex>            # required; matches core's GOSLEEP_INTERNAL_SECRET
GOSLEEP_HOOK_TIMEOUT_S=600                         # long-poll ceiling (hooks.md:415 default)
GOSLEEP_HOOK_CONNECT_S=2                           # curl connect ceiling; below this = fail-open
GOSLEEP_HOOK_DEBUG_LOG=$HOME/.gosleep-hook.jsonl   # optional per-call receipt
