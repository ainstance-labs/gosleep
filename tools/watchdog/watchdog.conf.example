# gosleep watchdog configuration — copy to tools/watchdog/watchdog.conf and edit.
# (watchdog.conf is machine-local runtime config; do NOT commit it.)
#
# Precedence: this file > WD_* environment variables > built-in defaults.
# Every value is validated at startup; invalid config fails LOUDLY (exit 78) —
# a silently mis-armed watchdog is worse than none (warren invariant).

# --- mode (GSL-212/220, d-2026-07-28-001) -------------------------------------
# observe (the DEFAULT): the full decision tree runs on every tick and the ledger
# records what WOULD have happened (would_nudge / would_kill / would_rewake …) —
# nothing is nudged, killed, spawned or notified. This is the observational-run
# setting: several days of ledger first, arming after reading it.
# armed: actions are live. Arming is THIS explicit line — never a default, never
# an agent's edit; the owner uncomments it after the observational run (GSL-220)
# and a green armed-check (GSL-211).
#WD_MODE="observe"

# --- topology ---------------------------------------------------------------
# LIFE is judged from the platform roster (`claude agents --json` — one entry per
# live top-level Claude Code session), matched against the heartbeat's own
# "session"/"session_id" fields (written by tools/lab/heartbeat.sh). tmux below
# is only the ACTION address space (where an armed watchdog nudges/kills and
# where a re-woken orchestrator spawns) plus a corroboration bit in the ledger.
# tmux session the orchestrator + worker panes live in (Agent Teams = split panes).
#WD_TMUX_SESSION="gosleep"

# How the orchestrator pane is found: identity comes ONLY from the "pane"
# field of the heartbeat line ($TMUX_PANE — the orchestrator names itself,
# GSL-51 protocol). There is NO positional fallback (review C1: after the
# orchestrator dies, "first pane of the window" is typically a live WORKER).
# Unverifiable identity in a live session -> kill_refused + escalation.
# WD_ORCH_WINDOW_NAME only names the window a re-woken orchestrator spawns in.
#WD_ORCH_WINDOW_NAME="orchestrator"

# Binaries (launchd runs with a minimal PATH; set absolute paths if needed).
#WD_TMUX_BIN="/opt/homebrew/bin/tmux"
#WD_CLAUDE_BIN="claude"

# --- paths -------------------------------------------------------------------
# Heartbeat file — fixed by the skill contract (Heartbeat protocol, GSL-51).
#WD_HEARTBEAT_FILE="<repo>/docs/handoff/.orchestrator-heartbeat"
# Watchdog ledger — append-only JSONL, never truncated (see LEDGER.md).
#WD_LEDGER_FILE="<repo>/docs/handoff/.watchdog-ledger.jsonl"
# Runtime state (markers, counters, logs) — lives in gitignored .artifacts/.
#WD_STATE_DIR="<repo>/.artifacts/watchdog"
# Re-wake brief template (GSL-56): the fresh orchestrator's first prompt is
# built from this file (BRIEF-START/END block, {{...}} placeholders). If the
# file is missing, a minimal inline prompt is used and the ledger warns
# (event rewake_brief_missing).
#WD_REWAKE_BRIEF="<repo>/skill/orchestrating-delivery-agents/references/re-wake-brief.md"

# --- thresholds (seconds / percent) -------------------------------------------
# GSL-217: every number below comes from MEASUREMENT, not from the head.
# Method (repeatable): merge docs/lab/supervision/heartbeat.jsonl with the live
# docs/handoff/.orchestrator-heartbeat, dedup by ts, take the gaps between
# consecutive lines. Measured 2026-07-28 over 222 lines (2026-07-21..28):
#   busy fleet (open_workers>0):  median 436s, p90 620s
#   idle       (open_workers==0): median 1856s, p90 5120s
#   every gap above 3900s was an owner standby / declared pause
# Acceptance invariant (GSL-217): no staleness threshold below the measured
# idle median (1856s).
#
# Heartbeat older than this = stale. Default 3900 = ~2.1x the idle median;
# historically ~5% of gaps exceed it and ALL of them were owner standbys
# written as status "ok". The orchestrator-side cure for that noise is
# declaring standby as "quiesced" (shielded class), not a higher number here —
# the observational run (GSL-220) measures exactly this false-positive rate.
#WD_HB_STALE_SECS=3900
# GSL-215: where the record-only "slow" class begins. MUST stay strictly below
# WD_HB_STALE_SECS (validated, exit 78) — that inequality is what makes "slow
# never acts" true by construction. 0 = derive WD_HB_STALE_SECS / 2.
#WD_HB_SLOW_SECS=0
# The ladder (GSL-216): nudge -> resume -> restart. After a nudge, how long the
# orchestrator gets to refresh the heartbeat before the next rung fires.
# 600 >= the busy p90 (620s ~ one long turn): the nudge lands at the next turn
# boundary, the grace covers it.
#WD_NUDGE_GRACE_SECS=600
# Rung 2 (only when the heartbeat carries session_id, GSL-212): kill + revive
# the SAME session via `claude --resume` — context intact. How long that revival
# gets before rung 3 (cold-start restart from the handoff). A legacy heartbeat
# without session_id skips rung 2 by construction. Rungs 2 and 3 spend the SAME
# RestartBudget with the same backoff — a resume loop is as much a masked bug.
#WD_RESUME_GRACE_SECS=600
# context_pct semantics (GSL-217, fixed everywhere): the model's HONEST estimate
# of the share of the context window CONSUMED so far, 0-100 — "how much is
# spent", never "how much remains"; it freezes when work freezes (that is what
# powers the frozen-progress detector). Measured reality: median 93, max 98,
# 150/222 lines at or above the old ceiling of 80 — the harness compacts on its
# own and the owner's standing rule (2026-07-20) forbids rolling on the model's
# self-estimate. Therefore the DEFAULT is 100 = enforcement OFF (the branch is
# skipped at >= 100); the value still travels on every tick line for the
# record. Re-enable (<= 99) only when GSL-182 lands a real harness signal.
#WD_CONTEXT_CEILING_PCT=100
# After a handoff request, how long before kill + re-wake from the handoff.
#WD_HANDOFF_WAIT_SECS=600
# Quota-wait alarm-clock backstop (GSL-69 + GSL-65 review M1, contract v0.5.1):
# a quiesced heartbeat whose note carries "quota-wait until <ISO ETA>" stands
# the watchdog down — but only while the ETA holds. A limited orchestrator
# cannot run turns, so the single wake-up it armed cannot survive the wait;
# once the ETA is more than this many seconds in the past, quiesced stops
# shielding and the normal decision tree applies (ONE nudge first — it lands
# now that the window is open; kill + re-wake only if the nudge doesn't take).
# Keep this LONGER than the orchestrator's own ~120s resume margin so
# self-resume always wins the race. No/unparseable ETA = shield stays up
# (fail safe); chain-done quiesced (open_workers=0, no ETA) never restarts.
#WD_QUOTA_GRACE_SECS=900

# --- restart budget + escalation (PRD R1.3; warren RestartBudget) --------------
# Max restarts per sliding window. Exhausted budget = NO kill, NO restart —
# escalate to the owner instead ("never mask an orchestrator bug with a
# restart loop"). File-backed: survives watchdog restarts. For a night window
# the owner may set e.g. 3 restarts / 8h.
#WD_RESTART_BUDGET=3
#WD_RESTART_WINDOW_SECS=3600
# Exponential backoff before each re-wake: min(cap, base * 2^restarts_in_window).
#WD_BACKOFF_BASE_SECS=1
#WD_BACKOFF_CAP_SECS=16
# Re-escalate at most this often while the orchestrator is still down.
#WD_ESCALATE_REPEAT_SECS=3600
# Optional executable called with the escalation message — the phase-6 push
# (ntfy / Claude-app) extension point. Must be executable; validated at start.
#WD_ESCALATE_HOOK=""

# --- frozen-progress detector (GSL-213; audit findings 5, 88) -------------------
# The audit's number-one failure: 60.8 hours of an immobile cycle under a healthy
# pulse. The detector calls it for zero tokens: WD_FROZEN_TICKS consecutive ticks
# in which BOTH `cycle` and `context_pct` are immobile (fresh heartbeat, status
# "ok" only), spanning at least WD_FROZEN_MIN_SPAN_SECS of wall clock ->
# progress_frozen in the ledger. RECORD-ONLY: it never acts by itself. Note for
# the observational run: legitimate owner standby also freezes the cycle — read
# the observe ledger's false-positive rate before tightening these.
#WD_FROZEN_TICKS=20
#WD_FROZEN_MIN_SPAN_SECS=3600

# --- Gastown debounce rails (PRD R1.4) -----------------------------------------
# Warm-up exemption from staleness for a freshly started session (Gastown #567:
# heartbeat checks killed sessions before they could write their first line).
#WD_STARTUP_GRACE_SECS=120
# "pane-alive != process-alive" becomes a zombie only after this many
# CONSECUTIVE cycles (transient gaps during handoffs diverge routinely).
#WD_ZOMBIE_CYCLES=3
# Minimum gap between force-kills.
#WD_KILL_COOLDOWN_SECS=300
# Whole session gone while the last heartbeat recorded >= N workers = systemic
# failure (tmux server death / reboot / sleep) -> escalate, never blind-restart.
#WD_MASS_DEATH_WORKERS=2
# The watchdog itself: single-flight lock (stale locks stolen after
# WD_LOCK_STALE_SECS) + self rate-limit between ticks.
#WD_MIN_TICK_INTERVAL_SECS=60
#WD_LOCK_STALE_SECS=900
# Process expected somewhere under the orchestrator pane's process tree.
#WD_AGENT_PROC_REGEX="claude"

# NOTE on --dry-run: external actions (send-keys/kill/spawn/notify/sleep) are
# suppressed, but the watchdog's OWN state (markers, restart history, ledger
# lines flagged dry_run) IS written — that is what makes sequences testable.
# For diagnosis against a live installation, point WD_STATE_DIR at a scratch
# copy so a manual dry-run tick can't consume the real budget/markers.
