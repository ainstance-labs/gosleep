<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  gosleep — launchd carrier for the safety tick (GSL-201). TEMPLATE: __REPO__ is substituted by
  preflight-arm.sh at install time; the OWNER installs it (launchctl is owner-only by standing
  rule — agents prepare, never load).

  What launchd gives us: survives reboot and login, fires every StartInterval seconds while the
  machine is AWAKE. What it does not give us (audit, question 5): StartInterval does NOT tick
  while the machine sleeps — the preflight night runs on the owner's usual caffeinate setup, and
  the morning report (tick-preflight-report.sh) shows exactly what that meant in practice.
  RunAtLoad fires one tick immediately on load/login — the closest launchd comes to a catch-up
  run after a wake or reboot.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gosleep.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/tools/lab/tick.sh</string>
    <string>--carrier</string>
    <string>launchd</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StandardOutPath</key>
  <string>__REPO__/.artifacts/lab/launchd-tick.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/.artifacts/lab/launchd-tick.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
